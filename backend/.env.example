PORT=3001
DATABASE_URL=postgres://postgres:hackathon@localhost:5432/postgres
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
RECOMMENDATION_RATE_LIMIT_MAX=30
AI_MODE=offline
# AI_PROVIDER_ORDER=ollama,plantilla-local

# Opcional: solo si quieres habilitar Gemini en modo hybrid o cloud-first
# GEMINI_API_KEY=AIza...

# --- Solo para pruebas del fallback de IA, no dejar en true en la demo ---
# FORCE_GEMINI_FAILURE=true   # simula que Gemini falla y fuerza el intento con Ollama
# FORCE_OLLAMA_FAILURE=true   # (combinado con la anterior) simula que Ollama también falla, cae a la plantilla local
